# Secrets
.env
# editor swap files for .env (vim .swp/.swo) — never commit, keep locally
.env.sw?

# OS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Local macOS application build output
build/
dist/

# 评估缓存（可复现的 LLM 调用结果，不入库）
eval/cache/

# Node
node_modules/

# Tooling
.specify/
.claude/

# Parallel dev worktrees
.worktrees/

# Scan samples stay local only
test-images/*.pdf

# Webapp runtime storage (documents/jobs) — never commit
.g2n-storage/

# Local CLI run artifacts next to test images (outputs, the .jpg fixtures stay tracked)
test-images/*.md
test-images/timing.json
test-images/assets/
test-images/preprocessed/

# Never commit source PDFs anywhere
*.pdf

# Except: the shipped gold-review PDF pack (deliverable) stays tracked
!eval/reports/gold-review/gold-review-pack.pdf

# Large rendered page images (issue 09) stay local; keep the small reports
out/*/pages/
out/*/cache/

# Synthetic print sample images (issue 08) — keep the evidence JSON, drop images
.scratch/**/reports/route-b/scripts/data/synth_print/*.jpg
